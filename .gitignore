# Lista de archivos y carpetas que Git NO debe subir a internet (como GitHub) por seguridad o por ser muy pesados.

# Logs (Errores registrados)
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Carpetas muy pesadas o generadas automáticamente
# La carpeta node_modules nunca se sube porque pesa mucho. Cada quien la descarga con 'npm install'.
node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Local Netlify folder
.netlify

# Environment variables
.env
.env.local
.env.*.local

# Drizzle generated files (if any in root)
drizzle/
migrate.ts
migrate-raw.ts
local-server.ts
